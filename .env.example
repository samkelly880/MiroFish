# ===== LLM provider =====
# Primary (default): Grok CLI — no xAI API key required after `grok login`
LLM_PROVIDER=grok-cli
# Optional Grok CLI overrides:
# GROK_CLI_BIN=grok
# GROK_CLI_MODEL=grok-4.6-build
# GROK_CLI_TIMEOUT_SECONDS=300

# Secondary (optional): any OpenAI-compatible HTTP API
# Set LLM_PROVIDER=openai-compatible to use these instead of Grok CLI.
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# xAI HTTP API example (optional alternative to Grok CLI):
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL_NAME=grok-4

# ===== Zep memory graph (required) =====
# Free monthly quota is enough for light usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Optional boost LLM (openai-compatible parallel runs only) =====
# If unused, omit these keys from your .env file entirely.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
