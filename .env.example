# LLM API configuration (any OpenAI-compatible API)
# Examples:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
#   xAI/Grok: LLM_BASE_URL=https://api.x.ai/v1
#             LLM_MODEL_NAME=grok-4
# Note: simulations can be costly; try fewer than 40 rounds first.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Zep memory graph =====
# Free monthly quota is enough for light usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Optional boost LLM =====
# If unused, omit the keys below from your .env file entirely.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
